<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission demandée à l'exécution avant d'ouvrir la caméra -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Nécessaire au téléchargement des tuiles Google Maps -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Aucune permission de localisation : on affiche des coordonnées déjà enregistrées -->

    <!-- La caméra n'est pas obligatoire : l'application reste installable sans -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+ : rendre visibles les applications d'appel et de messagerie -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MesContacts">

        <!-- Clé Google Maps : valeur injectée depuis local.properties (non publiée sur GitHub) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Une seule activité : elle héberge les trois fragments -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partage du fichier photo avec l'application caméra -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
